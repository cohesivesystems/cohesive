<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableCohesiveGlobalUsings>false</EnableCohesiveGlobalUsings>
    <RestoreSources>$(CohesivePackageFeed)</RestoreSources>
  </PropertyGroup>

  <Target Name="ValidateSmokeProperties" BeforeTargets="Restore">
    <Error Condition="'$(CohesivePackageVersion)' == ''" Text="CohesivePackageVersion is required." />
    <Error Condition="'$(CohesivePackageFeed)' == ''" Text="CohesivePackageFeed is required." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Cohesive.Simulation.Xunit" Version="$(CohesivePackageVersion)" />
  </ItemGroup>

</Project>
