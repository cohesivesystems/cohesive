<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <UserSecretsId>cohesive-aspire-first-example</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Orders.Model/Orders.Model.csproj" IsAspireProjectResource="false" />
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.2" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.Aspire/Cohesive.Adapters.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.Aspire.Postgres/Cohesive.Adapters.Aspire.Postgres.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.Postgres.Services/Cohesive.Adapters.Postgres.Services.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../../../src/Cohesive.Host/Cohesive.Host.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../OrderWorker/OrderWorker.csproj" ReferenceOutputAssembly="true" Private="true" ExcludeAssets="none" />
  </ItemGroup>
</Project>
