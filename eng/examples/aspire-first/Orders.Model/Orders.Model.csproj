<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Explicit portable source root for CallerFilePath and generated process attribution. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../..'))=/_</PathMap>
    <EnableCohesiveGlobalUsings>false</EnableCohesiveGlobalUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.Postgres.Services/Cohesive.Adapters.Postgres.Services.csproj" />
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.Postgres/Cohesive.Adapters.Postgres.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <ProjectReference Include="../../../../src/adapters/Cohesive.Adapters.AspNet/Cohesive.Adapters.AspNet.csproj" />
    <ProjectReference Include="../../../../src/Cohesive.Analyzers/Cohesive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
