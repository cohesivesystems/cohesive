<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AspireUseCliBundle Condition="'$(AspireCliPath)' != ''">true</AspireUseCliBundle>
    <AspireUseCliBundle Condition="'$(AspireCliPath)' == ''">false</AspireUseCliBundle>
    <NoWarn Condition="'$(AspireCliPath)' == ''">$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>cohesive-materialization-harness-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/adapters/Cohesive.Adapters.Aspire/Cohesive.Adapters.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../model/Cohesive.MaterializationHarness.Model.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
