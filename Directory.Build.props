<Project>
  <PropertyGroup>
    <!-- NuGet audit data can be unavailable in local/offline restores; suppress only that fetch warning. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>Cohesive Systems</Authors>
    <Company>Cohesive Systems</Company>
    <Description>Cohesive semantic system definition and orchestration building blocks.</Description>
    <PackageProjectUrl>https://cohesive.to</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/cohesivesystems/cohesive</RepositoryUrl>
    <PackageTags>cohesive;semantic;orchestration;relations;presentation;processes;configuration</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Link="README.md" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Cohesive.Analyzers' and '$(EnableCohesiveGlobalUsings)' != 'false'">
    <!-- Make Prelude helpers available without per-project using declarations. -->
    <Using Include="Cohesive.Prelude" />
    <Using Include="Cohesive.Domain" />
  </ItemGroup>
</Project>
