root = true

[*.ts]
tab_width = 2
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# Formatting
csharp_new_line_before_open_brace = all
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true

# Match existing repo style: modern C# with file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Prefer var in obvious cases, but don't force it everywhere
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Simple members can be expression-bodied
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_indexers = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_local_functions = false:suggestion

# Keep qualification preference loose, since the repo doesn't look strict about it
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Prefer explicit interfaces where useful, but don't over-police
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion

# Require method-local constants to use PascalCase
dotnet_naming_rule.local_constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.local_constants_should_be_pascal_case.symbols = local_constants
dotnet_naming_rule.local_constants_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Nullable and unused code hygiene
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0011.severity = warning

# Encourage XML docs on public APIs
dotnet_diagnostic.CS1591.severity = warning
