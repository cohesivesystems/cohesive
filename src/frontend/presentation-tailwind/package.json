{
  "name": "@cohesivesystems/presentation-tailwind",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../eng/fix-package-js-imports.mjs dist",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cohesivesystems/presentation-contracts": "workspace:*",
    "@cohesivesystems/presentation-core": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Tailwind CSS helpers and theme primitives for Cohesive presentation modules.",
  "keywords": [
    "cohesive",
    "presentation",
    "tailwindcss",
    "theme"
  ],
  "author": "Cohesive Systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cohesivesystems/cohesive.git",
    "directory": "src/frontend/presentation-tailwind"
  },
  "bugs": {
    "url": "https://github.com/cohesivesystems/cohesive/issues"
  },
  "homepage": "https://github.com/cohesivesystems/cohesive#readme"
}
