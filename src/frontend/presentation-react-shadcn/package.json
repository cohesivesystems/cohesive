{
  "name": "@cohesivesystems/presentation-react-shadcn",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../eng/fix-package-js-imports.mjs dist",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cohesivesystems/presentation-contracts": "workspace:*",
    "@cohesivesystems/presentation-core": "workspace:*",
    "@cohesivesystems/presentation-react": "workspace:*",
    "@cohesivesystems/presentation-tailwind": "workspace:*"
  },
  "peerDependencies": {
    "class-variance-authority": ">=0.7",
    "clsx": ">=2",
    "lucide-react": ">=1",
    "radix-ui": ">=1",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7",
    "@tanstack/react-table": ">=8",
    "tailwind-merge": ">=3"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "shadcn/ui-oriented React renderers for Cohesive presentation modules.",
  "keywords": [
    "cohesive",
    "presentation",
    "react",
    "shadcn"
  ],
  "author": "Cohesive Systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cohesivesystems/cohesive.git",
    "directory": "src/frontend/presentation-react-shadcn"
  },
  "bugs": {
    "url": "https://github.com/cohesivesystems/cohesive/issues"
  },
  "homepage": "https://github.com/cohesivesystems/cohesive#readme"
}
