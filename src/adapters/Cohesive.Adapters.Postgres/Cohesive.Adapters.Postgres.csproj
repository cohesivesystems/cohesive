<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);COHESIVE_POSTGRES_INTERNAL_PREPARATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cohesive.Adapters.Sql/Cohesive.Adapters.Sql.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />

    <ProjectReference Include="..\..\Cohesive.Relations\Cohesive.Relations.csproj" />
    <ProjectReference Include="..\..\Cohesive.Processes.Distribution\Cohesive.Processes.Distribution.csproj" />
    <ProjectReference Include="..\..\Cohesive.Storage\Cohesive.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the canonical internal preparation implementation without widening Core's API or friend access. -->
    <Compile Include="../../Cohesive/Model/WeakPreparationCache.cs" Link="Internal/WeakPreparationCache.cs" />
    <Compile Include="../../Cohesive/Model/PreparationSlot.cs" Link="Internal/PreparationSlot.cs" />
  </ItemGroup>
</Project>
