<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Exact Cohesive.Infra Azure resource construction and native resource binding seams through Pulumi.</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleDurableTaskSdk</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <None Update="APP-SERVICE.md" Pack="true" PackagePath="/" />
    <None Update="BLOB-STORAGE.md" Pack="true" PackagePath="/" />
    <None Update="ENTRA.md" Pack="true" PackagePath="/" />
    <None Update="TELEMETRY.md" Pack="true" PackagePath="/" />
    <None Update="KEY-VAULT.md" Pack="true" PackagePath="/" />
    <None Update="COSMOS.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Pulumi" Version="3.113.1" />
    <PackageReference Include="Pulumi.AzureAD" Version="6.9.0" />
    <PackageReference Include="Pulumi.AzureNative" Version="3.16.0" />
    <ProjectReference Include="../../Cohesive.Infra/Cohesive.Infra.csproj" />
    <ProjectReference Include="Generated/dotnet/Pulumi.AzureNative_durabletask_v20251101.csproj" PrivateAssets="all" />
  </ItemGroup>
  <!-- This generated SDK is bundled, never independently published under Pulumi's package identity. -->
  <!-- Pack consumes prior build output, including when the release disables building. -->
  <Target Name="BundleDurableTaskSdk" DependsOnTargets="BuildOnlySettings">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Pulumi.AzureNative_durabletask_v20251101.dll" />
    </ItemGroup>
  </Target>
</Project>
