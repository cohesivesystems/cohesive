<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Bounded external-process snapshot import adapter for Cohesive.Simulation generation catalogs.</Description>
    <PackageTags>$(PackageTags);simulation;synthetic-data;external-process;python</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CohesiveAdapterPackageVersion" Value="$(PackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cohesive.Simulation\Cohesive.Simulation.csproj" />
  </ItemGroup>

</Project>
