<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Native OpenTelemetry registration for Cohesive tracing and metric scopes.</Description>
    <PackageTags>cohesive;opentelemetry;observability;tracing;metrics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cohesive\Cohesive.csproj" />
    <ProjectReference Include="..\Cohesive.Relations\Cohesive.Relations.csproj" />
    <ProjectReference Include="..\Cohesive.Processes.Distribution\Cohesive.Processes.Distribution.csproj" />
  </ItemGroup>

</Project>
